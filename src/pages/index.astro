---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
posts.sort((a, b) => b.id.localeCompare(a.id));
---

<Layout title="ゲーム開発日記">

  <h2>記事一覧</h2>

  <ul>
    {posts.map(post => (
      <li>
        <a href={`/blog/${post.id}/`}>
          {post.data.title}
        </a>
      </li>
    ))}
  </ul>

</Layout>